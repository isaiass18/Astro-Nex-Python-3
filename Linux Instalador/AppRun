#!/bin/bash

# Custom AppRun for Astro-Nex AppImage

HERE="$(dirname "$(readlink -f "${0}")")"

# Configure GTK and GI Typelib paths
export GI_TYPELIB_PATH="${HERE}/usr/lib/girepository-1.0:${GI_TYPELIB_PATH}"
export GSETTINGS_SCHEMA_DIR="${HERE}/usr/share/glib-2.0/schemas:${GSETTINGS_SCHEMA_DIR}"
export GTK_DATA_PREFIX="${HERE}/usr"
export XDG_DATA_DIRS="${HERE}/usr/share:${XDG_DATA_DIRS}"

# Configure Python
export PYTHONHOME="${HERE}/usr"
export PYTHONPATH="${HERE}/usr/share/astronex:${HERE}/usr/lib/python3.8:${HERE}/usr/lib/python3.8/site-packages:${PYTHONPATH}"

# Source linuxdeploy hooks (e.g. GTK plugin)
if [ -d "${HERE}/apprun-hooks" ]; then
    for hook in "${HERE}/apprun-hooks"/*; do
        source "$hook"
    done
fi

# Fix GDK Pixbuf Loaders cache paths for AppImage read-only fs
export GDK_PIXBUF_MODULEDIR="${HERE}/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders"
export GDK_PIXBUF_MODULE_FILE="/tmp/astronex-loaders-${USER}.cache"
if [ -f "${HERE}/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache" ]; then
    sed "s|\"libpixbuf|\"${GDK_PIXBUF_MODULEDIR}/libpixbuf|g" "${HERE}/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache" > "$GDK_PIXBUF_MODULE_FILE" 2>/dev/null || true
fi

# Ensure the Astro-Nex font is available to the system fontconfig
if [ ! -f "$HOME/.fonts/Astro-Nex.ttf" ]; then
    mkdir -p "$HOME/.fonts"
    cp "${HERE}/usr/share/fonts/truetype/astronex/Astro-Nex.ttf" "$HOME/.fonts/" 2>/dev/null || true
    fc-cache -f "$HOME/.fonts" 2>/dev/null || true
fi

# Run the application using the bundled Python
exec "${HERE}/usr/bin/python3" "${HERE}/usr/share/astronex/nex.py" "$@"
