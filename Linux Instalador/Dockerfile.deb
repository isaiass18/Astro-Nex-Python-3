FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y dpkg-dev && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /deb_build/opt/astro-nex \
    /deb_build/usr/share/applications \
    /deb_build/usr/share/icons/hicolor/48x48/apps \
    /deb_build/usr/bin \
    /deb_build/DEBIAN

# The DEB intentionally ships the self-contained AppImage produced by the
# previous build stage. Both delivery formats therefore run the same runtime.
COPY --from=astronex-builder /Astro-Nex-v2.0-Linux-x86_64.AppImage /deb_build/opt/astro-nex/Astro-Nex.AppImage
COPY --from=astronex-builder /workspace/AppDir/usr/share/icons/hicolor/48x48/apps/astronex.png /deb_build/usr/share/icons/hicolor/48x48/apps/astro-nex.png
COPY --from=astronex-builder /workspace/AppDir/usr/share/applications/astronex.desktop /deb_build/usr/share/applications/astro-nex.desktop
COPY --from=astronex-builder /workspace/AppDir/usr/share/fonts/truetype/astronex/Astro-Nex.ttf /deb_build/usr/share/fonts/truetype/astronex/

RUN printf '%s\n' '#!/bin/sh' 'exec /opt/astro-nex/Astro-Nex.AppImage --appimage-extract-and-run "$@"' > /deb_build/usr/bin/astro-nex \
    && chmod 755 /deb_build/usr/bin/astro-nex /deb_build/opt/astro-nex/Astro-Nex.AppImage \
    && sed -i 's|Exec=AppRun|Exec=/usr/bin/astro-nex|; s|Icon=astronex|Icon=astro-nex|' /deb_build/usr/share/applications/astro-nex.desktop \
    && printf '%s\n' '#!/bin/sh' 'fc-cache -f >/dev/null 2>&1 || true' > /deb_build/DEBIAN/postinst \
    && chmod 755 /deb_build/DEBIAN/postinst

RUN printf '%s\n' \
    'Package: astronex' \
    'Version: 2.0' \
    'Architecture: amd64' \
    'Maintainer: Isaias <isaias@example.com>' \
    'Description: Astro-Nex 2.0' \
    > /deb_build/DEBIAN/control \
    && dpkg-deb --build /deb_build /Astro-Nex-v2.0-Ubuntu24.04-amd64.deb \
    && dpkg-deb --info /Astro-Nex-v2.0-Ubuntu24.04-amd64.deb

CMD ["/bin/bash"]
